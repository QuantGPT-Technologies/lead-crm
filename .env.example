# =============================================================================
# Copy this file to  .env.local  and fill in the values. Never commit .env.local
# =============================================================================

# ---- Supabase (REQUIRED) ----------------------------------------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# "anon public" key (or the new "publishable" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (or the new "secret" key). SERVER ONLY - never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App (REQUIRED) ---------------------------------------------------------
# Any long random string. Used to sign login-step cookies.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

NEXT_PUBLIC_APP_NAME=Lead CRM
NEXT_PUBLIC_COMPANY_NAME=Your Company Pvt. Ltd.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# ---- Login flow -------------------------------------------------------------
# Step 1 "Global Sign In" (shared company email + password). true / false
AUTH_REQUIRE_GLOBAL_LOGIN=true
# Step 3 email OTP. Needs the Supabase email template to contain {{ .Token }}
# (see README). Set false to sign in with user id + password only.
AUTH_REQUIRE_OTP=false

# ---- First admin (used only by `npm run setup:admin`) -----------------------
SETUP_ADMIN_NAME=Admin
SETUP_ADMIN_EMAIL=admin@example.com
SETUP_ADMIN_PASSWORD=ChangeMe@123
SETUP_GLOBAL_EMAIL=company@example.com
SETUP_GLOBAL_PASSWORD=ChangeMe@123

# ---- Email sending (OPTIONAL) -----------------------------------------------
# With a Resend key, emails composed in the CRM are really sent.
# Without it they are saved to the message log and opened in the user's mail app.
RESEND_API_KEY=
EMAIL_FROM="Lead CRM <no-reply@yourdomain.com>"

# ---- Firebase push notifications for follow-up reminders (OPTIONAL) ---------
# Firebase Console -> Project settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings -> Cloud Messaging -> Web Push certificates -> Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Project settings -> Service accounts -> Generate new private key (JSON file)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Secret for the reminder cron endpoint: GET /api/cron/followup-reminders?secret=...
CRON_SECRET=
